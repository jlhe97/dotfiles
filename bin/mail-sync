#!/bin/bash
# Pull mail into the local maildir and (re)index it with notmuch.
# Run periodically (launchd/systemd timer) or on neomutt launch (see bin/mutt).
set -euo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/mail-provider"

if ! command -v mbsync &>/dev/null; then
    echo "mail-sync: mbsync not found (install isync)" >&2
    exit 1
fi
if ! command -v notmuch &>/dev/null; then
    echo "mail-sync: notmuch not found" >&2
    exit 1
fi

mkdir -p "$MAIL_DIR"

echo "Syncing $MAIL_PROVIDER (mbsync)..."
# A non-fatal mbsync error must not skip indexing: mail already fetched still
# has to reach the notmuch database.
mbsync_status=0
mbsync -a || mbsync_status=$?
if [ "$mbsync_status" -ne 0 ]; then
    echo "mail-sync: mbsync exited $mbsync_status (continuing to index what was fetched)" >&2
fi

echo "Indexing (notmuch)..."
notmuch new

exit "$mbsync_status"
