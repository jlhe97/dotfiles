#!/bin/bash
# Pull Fastmail into the local maildir and (re)index it with notmuch.
# Run periodically (launchd/systemd timer) or on neomutt launch (see bin/mutt).
set -euo pipefail

MAIL_DIR="$HOME/Mail/fastmail"

if ! command -v mbsync &>/dev/null; then
    echo "mail-sync: mbsync not found (install isync)" >&2
    exit 1
fi
if ! command -v notmuch &>/dev/null; then
    echo "mail-sync: notmuch not found" >&2
    exit 1
fi

mkdir -p "$MAIL_DIR"

echo "Syncing Fastmail (mbsync)..."
# Don't let a non-fatal mbsync error (e.g. a folder deleted on the server) abort
# the run before indexing — mail already fetched must still be indexed so neomutt
# sees it. Capture the status, always index, then surface any failure.
mbsync_status=0
mbsync -a || mbsync_status=$?
if [ "$mbsync_status" -ne 0 ]; then
    echo "mail-sync: mbsync exited $mbsync_status (continuing to index what was fetched)" >&2
fi

echo "Indexing (notmuch)..."
notmuch new

exit "$mbsync_status"
