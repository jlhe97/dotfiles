# Identity and transport settings come from generated ~/.neomutt/local.rc.
source `uname -s | grep -q Darwin && echo ~/.neomutt/macos.rc || echo ~/.neomutt/linux.rc`

set smtp_pass = "`$HOME/bin/mail-pass`"
set smtp_authenticators = "plain"
set ssl_starttls = yes
set ssl_force_tls = yes
set editor = "$HOME/bin/dotfiles-editor"

set virtual_spool_file = yes
set nm_query_type = "threads"

virtual-mailboxes \
    "Inbox"   "notmuch://?query=folder:INBOX" \
    "Unread"  "notmuch://?query=tag:unread" \
    "Flagged" "notmuch://?query=tag:flagged" \
    "Sent"    "notmuch://?query=folder:Sent"

# Local Sent syncs to Kernel/Sent, not personal Sent.
set record = "$my_maildir/Sent"
set copy = yes

# NeoMutt requires the cache backend before header_cache.
ifdef lmdb "set header_cache_backend = lmdb"
set header_cache = "~/.cache/neomutt-kernel"
# Skip per-message stat calls when opening large mailboxes.
set maildir_header_cache_verify = no
# Limit startup loading; older mail remains searchable with X.
set nm_db_limit = 500

set quote_regex = "^([ \t]*[|>:}])+"
color body green default "^[+]($|[^+ ].*| ([^[:alnum:]\`'\"(].*)?$)"
color body red default "^-($|[^- E].*|E[^A-Z0-9_].*| ([^[:alnum:]\`'\"(].*)?$)"
color body cyan default "^@@ -[0-9].*"
color body brightyellow default "^diff --git .*"
color body brightyellow default "^index [0-9a-f]+[.][.][0-9a-f]+.*"
color body brightyellow default "^(--- |[+][+][+] ).*"
color body brightyellow default "^---$"
color body magenta default "^commit [0-9a-f]+"
color body blue default "^(Author|Date):.*"
color body brightblue default "^Subject:.*"
color body brightcyan default "^[A-Za-z-]+-by:.*"
color body brightcyan default "^Cc:.*"

color quoted    blue       default
color quoted1   cyan       default
color quoted2   green      default
color quoted3   yellow     default
color quoted4   magenta    default

set wrap = 0
set pager_stop = yes
set pager_index_lines = 10
set sort = threads
set sort_aux = last-date
set strict_threads = yes
set index_format = "%4C %Z %{%b %d} %-20.20L %s"

set sidebar_visible = no
set sidebar_width = 30
set sidebar_format = "%B%?F? [%F]?%* %?N?%N/?%S"
set sidebar_sort_method = unsorted
bind index,pager \Cj sidebar-next
bind index,pager \Ck sidebar-prev
bind index,pager \Co sidebar-open
bind index,pager B sidebar-toggle-visible

folder-hook . 'push <collapse-all>'
bind index <return> collapse-thread
bind index za collapse-thread
bind index zA collapse-all
bind index l display-message

bind pager j next-line
bind pager k previous-line
bind pager g top
bind pager G bottom

bind index,pager X change-vfolder

set signature = "~/.signature"
set sig_dashes = yes
set sig_on_top = no
