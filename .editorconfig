# Editor agnostic configuration

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.sh,bin/*,*Dockerfile}]
indent_style = space
indent_size = 4

[{*bats,*.lua,*.{yml,yaml}}]
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
