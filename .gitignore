# Claude Code writes credentials, history and caches here. Nothing under
# .claude is tracked, so ignore the whole directory rather than chasing each
# new file it invents.
.claude/

# Local overrides (machine-specific, not public)
.zshrc.local
.neomutt/local.rc
.mbsyncrc
.notmuch-config
.signature
# Generated per machine: holds the absolute path of this host's pinentry.
.gnupg/gpg-agent.conf

# GnuPG keyring material must never reach a public repo. gpg.conf is the only
# file under .gnupg that belongs here; everything else is ignored outright so
# a stray `gpg --homedir` or a copied keyring cannot be committed by accident.
.gnupg/*
!.gnupg/gpg.conf

# Site-specific installer settings
install.local

# Mail provider overrides (personal choice of provider, not public).
.config/dotfiles/mail.conf
