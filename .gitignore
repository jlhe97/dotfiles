# Claude sensitive files
.claude/.credentials.json
.claude/settings.local.json
.claude/stats-cache.json
.claude/history.jsonl

# Local overrides (machine-specific, not public)
.zshrc.local
.neomutt/local.rc
.mbsyncrc
.notmuch-config
# Generated per machine: holds the absolute path of this host's pinentry.
.gnupg/gpg-agent.conf

# GnuPG keyring material must never reach a public repo. gpg.conf is the only
# file under .gnupg that belongs here; everything else is ignored outright so
# a stray `gpg --homedir` or a copied keyring cannot be committed by accident.
.gnupg/*
!.gnupg/gpg.conf

# Claude ephemeral/session data
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/file-history/
.claude/ide/
.claude/paste-cache/
.claude/plans/
.claude/plugins/
.claude/projects/
.claude/session-env/
.claude/shell-snapshots/
.claude/statsig/
.claude/telemetry/
.claude/todos/
